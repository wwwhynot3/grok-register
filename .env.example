# Gmail IMAP（免费注册版 grok_free.py 用；+alias 无限衍生邮箱收验证码）
# 获取: Google 账户 → 安全 → 两步验证 → 应用专用密码（16位）
GMAIL_USER="your_gmail@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# YesCaptcha（必填，注册用。https://yescaptcha.com 获取）
YESCAPTCHA_KEY="your_yescaptcha_key"

# 邮箱提供商: gptmail / mailtm / luckmail / mailnest / gmail
# 可逗号分隔组成回退链，按顺序尝试，失败自动切下一个（如 "luckmail,gmail" 先买号、买不到转 Gmail）
EMAIL_PROVIDER="gptmail"

# Grok 注册线程数（可选，免费号建议 1，避免风控）
THREADS="1"

# LuckMail 配置（仅在 EMAIL_PROVIDER=luckmail 时需要）
# LUCKMAIL_BASE_URL 已内置为 https://mails.luckyous.com，只有使用别的站点时才需要覆盖
# LUCKMAIL_BASE_URL="https://mails.luckyous.com"
LUCKMAIL_API_KEY="your_luckmail_api_key"
LUCKMAIL_API_SECRET=""
LUCKMAIL_USE_HMAC="false"
LUCKMAIL_PROJECT_CODE="grok"
LUCKMAIL_EMAIL_TYPE="ms_imap"
LUCKMAIL_DOMAIN="outlook.com"

# LuckMail 接码订单模式（EMAIL_PROVIDER=luckmail_order，推荐：按成功收费，无码不扣费）
# 回退链：第一个能下单的类型生效（成本：google_variant 0.006 / self_built 0.001 / ms 0.0125）
LUCKMAIL_ORDER_TYPES="google_variant,self_built,ms_imap"
# 谷歌变种模式（可选）：dot=点号 / plus=+号 / mixed=混合 / all=随机
LUCKMAIL_VARIANT_MODE=""

# MailNest 配置（仅在 EMAIL_PROVIDER=mailnest 时需要）
# 获取 apikey：https://mailnest.top/account
# 获取项目代码：https://mailnest.top/buy-email 默认为 x-ai001 可直接使用
MAILNEST_API_KEY="your_mailnest_api_key"
MAILNEST_PROJECT_CODE="x-ai001"

# 代理（注册/铸造出口）。默认 http://127.0.0.1:7897（本地 Clash 混合端口）
# VPS 上必须指向 mihomo 混合端口（如 http://127.0.0.1:7890），否则 CF 拦数据中心 IP
GROK_PROXY="http://127.0.0.1:7897"
#
# 禁用代理：设 0/false/no/off。⚠️ 仅本地白名单网络/直连场景用；
# 美国 VPS 直连会被 Cloudflare 拦截（403），建议始终走代理
# GROK_USE_PROXY="0"

# curl_cffi TLS 指纹 (grok.py)。默认 chrome=最新版；旧指纹(chrome120/124/131)会被 CF 拦(403)
# 默认指纹再次失效时，用 GROK_IMPERSONATE=chrome1xx 覆盖为当时最新版本
GROK_IMPERSONATE="chrome"

# 铸造失败自动重试的最大轮数 (device_mint --all), 每轮间等待 10s
MAX_MINT_ROUNDS="3"

# 自动补位 (auto_replenish) 参数：
# GROK_MIN_ACCOUNTS — Build 主池阈值,低于该数即触发补位,默认 2
# GROK_MIN_WEB_ACCOUNTS — Web 副池门槛,默认同 GROK_MIN_ACCOUNTS,可调低(如 30)
# GROK_REGISTER_CAP — 单轮补位最多注册数,默认 5
# GROK_REG_MAX_RETRIES — 单号注册重试上限,默认 3。⚠️ 每次重试=新买邮箱+新验证码
GROK_MIN_ACCOUNTS="2"
GROK_MIN_WEB_ACCOUNTS="0"
GROK_REGISTER_CAP="5"
GROK_REG_MAX_RETRIES="3"

# grok2api SQLite 数据库路径（Web 池计数用；不设会导致 Web 池计数恒为 0 而无限补位）
# GROK2API_DB="/path/to/grok2api/data/backend.db"

# grok2api 网关（推送/补位用）
# GROK2API_BASE="http://127.0.0.1:8000"
# GROK2API_USER="admin"
# GROK2API_PASS="your_password"

# 数据目录（默认：项目目录下 auths/ 与 keys/）
# GROK_AUTH_DIR="/path/to/auths"
# GROK_KEYS_DIR="/path/to/keys"

# Clash/mihomo 外部控制器（IP 轮换，可选；无控制器时自动禁用轮换）
# 默认 127.0.0.1:9097，secret 须与代理配置一致（当前为占位符，轮换不可用）
# CLASH_HOST="127.0.0.1"
# CLASH_PORT="9097"
# CLASH_SECRET="set-your-secret"
# CLASH_GROUP="轮换组"        # 你的订阅组名（proxy-groups 中的名字）
# STABLE_NODE=""              # 固定节点名（轮换禁用时的兜底出口）

# 数据根目录:keys/auths/logs 默认放 ~/.grok-register(挪出项目目录,防止误 git add 把 token 入库)
# GROK_DATA_DIR 整体覆盖;GROK_AUTH_DIR / GROK_KEYS_DIR / GROK_LOG_DIR 可单独覆盖
# VPS 上保持原数据位置时须显式设置,如 GROK_DATA_DIR="/root/workspace/grok-register"
# GROK_DATA_DIR="/path/to/data-root"
# GROK_LOG_DIR="/path/to/logs"
# GROK_AUTH_DIR="/path/to/auths"
# GROK_KEYS_DIR="/path/to/keys"

# 浏览器无头模式 (device_mint)。⚠️ VPS 上不要设 1：
# CF 检测 headless 指纹并拦截，必须用 xvfb-run -a 跑有头浏览器
# GROK_HEADLESS="0"

# 实测不可用的节点黑名单（精确名，逗号分隔；浏览器真实探测仍失败的节点加这里）
# GROK_SKIP_NODES="节点A,节点B"

# 补位双水位（daemon 自动选路径）
# GROK_MIN_ACCOUNTS="50"          # 付费保底水位（低于此走 grok.py YesCaptcha）
# GROK_MIN_FREE_ACCOUNTS="100"    # 免费路径水位（低于此走 grok_free 混合流）
# GROK_MIN_WEB_ACCOUNTS="30"      # Web 副池水位

# 免费路径节奏参数（全部 .env 可调）
# GROK_REGISTER_CAP="5"           # 单轮最多注册数
# GROK_FREE_RETRY="0"             # 失败是否换 IP 重试(1=重试;0=不重试,省邮箱 0.02/次)
# GROK_FREE_FAIL_STREAK="2"       # 连续 N 号失败提前终止本轮(1=最省,抑制期即停)
# GROK_FREE_SUPPRESSION_SLEEP="3600"  # 零增长后休眠秒数(设 86400 对齐次日抑制窗口)
# GROK_FREE_CIRCUIT_STREAK="0"    # 二级长熔断:连续 N 轮零增长 → 熔断到次日(0=禁用;
#                                  #   建议 3:连续 3 轮全败即长熔断+推送)
# GROK_FREE_CIRCUIT_SLEEP="86400" # 长熔断休眠秒数(默认次日)

# 告警(Telegram 优先,SMTP 兜底;alert.py 冷却去重防刷屏)
# TELEGRAM_BOT_TOKEN=""           # @BotFather 创建 bot 后获取
# TELEGRAM_CHAT_ID=""             # 私聊自己的 chat id(@userinfobot 查)
# ALERT_COOLDOWN_SECONDS="3600"   # 同类告警最小间隔(熔断/恢复类建议 86400)

# 余额监控（balance_monitor.py，VPS 每小时 timer 跑）
# LUCKMAIL_MIN_BALANCE="1.0"      # LuckMail 余额阈值
# YESCAPTCHA_MIN_POINTS="800"     # YesCaptcha 点数阈值
# ALERT_EMAIL_TO="you@example.com"   # 告警收件人
# GROK_STOP_CMD="systemctl stop vps-grok-replenish"   # 触发时关补水的命令
# SMTP_HOST="smtp.qq.com"         # 告警邮件 SMTP（QQ/foxmail 用 465 SSL）
# SMTP_PORT="465"
# SMTP_USER="you@qq.com"
# SMTP_PASS="app-password"
# SMTP_FROM="you@qq.com"
